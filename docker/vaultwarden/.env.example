# Copy to vaultwarden.env (chmod 600).
VAULTWARDEN_PORT=${VAULTWARDEN_PORT}
VAULTWARDEN_SERVE_PORT=${VAULTWARDEN_SERVE_PORT}
DOMAIN=https://<HOSTNAME>.<TAILNET>.ts.net:${VAULTWARDEN_SERVE_PORT}
SIGNUPS_ALLOWED=false
INVITATIONS_ALLOWED=false
SHOW_PASSWORD_HINT=false
WEB_VAULT_ENABLED=true
ROCKET_PORT=80
LOG_LEVEL=warn
IP_HEADER=X-Forwarded-For
# Argon2id hash, single-quoted. echo -n "$VAULTWARDEN_ADMIN_TOKEN" | argon2 "$(openssl rand -base64 32)" -id -t 3 -k 65540 -p 4 -l 32 -e
ADMIN_TOKEN='${VAULTWARDEN_ADMIN_TOKEN_ARGON2_HASH}'
