# Copy to <HERMES_HOME>/dashboard.env (mode 600).
HERMES_DASHBOARD_PUBLIC_URL=https://<HOSTNAME>.<TAILNET>.ts.net
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=${HERMES_DASHBOARD_USER}
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH=${HERMES_DASHBOARD_PASSWORD_HASH}
HERMES_DASHBOARD_BASIC_AUTH_SECRET=${HERMES_DASHBOARD_SESSION_SECRET}
